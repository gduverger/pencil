# Pencil web app — copy to .env.local for development. Everything is optional locally: the default
# is the embedded PGlite database, local file storage, the development sign-in and the Pro tier.

# --- core ---
DATABASE_URL=pglite://./.data/pencil        # Neon in production: postgres://user:pass@host/db?sslmode=require
AUTH_SECRET=change-me                       # `openssl rand -base64 32`
AUTH_URL=http://localhost:3000
PENCIL_BASE_URL=http://localhost:3000       # public origin for links in exports and checkout redirects
PENCIL_DEV_AUTH=1                           # development sign-in provider (never in production)

# --- sign-in (Auth.js) ---
# EMAIL_SERVER=smtp://user:pass@smtp.example.com:587
# EMAIL_FROM=Pencil <no-reply@example.com>
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=

# --- files (local directory by default; Cloudflare R2 / S3 in production) ---
PENCIL_FILES_DIR=.data/files
# S3_BUCKET=pencil-files
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- PDF render service (apps/render); unset = Chromium in-process ---
# PENCIL_RENDER_URL=https://pencil-render.fly.dev
# RENDER_TOKEN=

# --- billing (Stripe); unset = purchase buttons explain that billing is not configured ---
# STRIPE_SECRET_KEY=sk_live_…
# STRIPE_PRICE_PER_DEAL=price_…              # $199 one-time
# STRIPE_PRICE_PRO=price_…                   # $2,400 / year recurring
# STRIPE_WEBHOOK_SECRET=whsec_…
# PENCIL_DEFAULT_TIER=free                   # outside production the default tier is pro; set free to test gating

# --- assistant (Claude); unset = assistant panels say "not configured" ---
# ANTHROPIC_API_KEY=
# PENCIL_ASSISTANT_MODEL=claude-opus-5-5
# PENCIL_ASSISTANT_MONTHLY_TOKENS=2000000
# PENCIL_ASSISTANT_MONTHLY_REQUESTS=2000
# PENCIL_ASSISTANT_FAKE=1                    # scripted provider for demos and tests

# --- benchmarks and jobs ---
# PENCIL_SEED_BENCHMARKS=../../packages/benchmarks/seed/benchmarks.csv   # extra seed rows
# JOBS_SECRET=                               # nightly job; Vercel cron sends CRON_SECRET instead
# CRON_SECRET=

# --- observability ---
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.1
