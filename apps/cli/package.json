{
  "name": "@pencil/cli",
  "version": "0.1.0",
  "private": true,
  "description": "pencil run deal.json \u2192 outputs JSON, package HTML, PDF and XLSX from the command line.",
  "type": "module",
  "bin": {
    "pencil": "./bin/pencil.js"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pencil": "tsx --tsconfig tsconfig.tsx.json src/cli.ts"
  },
  "dependencies": {
    "@pencil/engine": "workspace:*",
    "@pencil/exports": "workspace:*",
    "@pencil/package-pages": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "@pencil/render": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
