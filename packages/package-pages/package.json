{
  "name": "@pencil/package-pages",
  "version": "0.1.0",
  "private": true,
  "description": "React components for the nine package pages, shared by the web app and the PDF renderer.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./format": "./src/format.ts",
    "./styles.css": "./src/styles.css",
    "./render": "./src/render.tsx"
  },
  "scripts": {
